    {
      "parameters": {
        "jsCode": "// Get the symbols from the Set node\nconst data = $input.first().json;\n\n// Check if symbols is a string or array\nlet symbols;\nif (typeof data.symbols === 'string') {\n  // If it's a string like '[\"AAPL\",\"MSFT\"]', parse it\n  symbols = JSON.parse(data.symbols);\n} else {\n  // If it's already an array, use it directly\n  symbols = data.symbols;\n}\n\n// Join with commas\nconst symbolString = symbols.join(',');\n\n// Build the URL with your API key\nconst url = `https://api.twelvedata.com/quote?symbol=${symbolString}&apikey=7df826a9529d4a5b99f38f131c9880e1`;\n\nconst key = '7df826a9529d4a5b99f38f131c9880e1';\n\n// Return the URL\nreturn {\n  url: url,\n  symbolString: symbolString,\n  key:key\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
