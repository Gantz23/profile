        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        -3072,
        -448
      ],
      "id": "43e24ea2-2721-4584-837a-c5267d386f4f",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const wrapper = item.json.data ? item.json.data[0] : item.json;\n\n  for (const quote of Object.values(wrapper)) {\n    if (quote && typeof quote === 'object' && quote.symbol) {\n      output.push({\n        json: {\n          symbol: quote.symbol,\n          name: quote.name,\n          datetime: quote.datetime,\n          open: parseFloat(quote.open),\n          high: parseFloat(quote.high),\n          low: parseFloat(quote.low),\n          close: parseFloat(quote.close),\n          volume: parseInt(quote.volume),\n          change: parseFloat(quote.change),\n          percent_change: parseFloat(quote.percent_change),\n          fifty_two_week_low: parseFloat(quote.fifty_two_week?.low),\n          fifty_two_week_high: parseFloat(quote.fifty_two_week?.high),\n        }\n      });\n    }\n  }\n}\n\nreturn output;"
      },
